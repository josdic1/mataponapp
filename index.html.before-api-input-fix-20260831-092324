      const res=await fetch(url,{credentials:"include",signal:dataAbort.signal});if(res.status===401||res.status===403){document.getElementById("dataLiveChip").textContent="Admin login required";document.getElementById("dataLiveChip").className="chip warn";document.getElementById("dataError").innerHTML='<div class="data-error"><strong>Admin login required.</strong> Use API Tester → Login, then come back and Refresh data.</div>';dataRows=[];dataTotal=0;renderDataGrid();return;}if(!res.ok)throw new Error(`${res.status} ${res.statusText}`);const data=await res.json();dataRows=Array.isArray(data.rows)?data.rows:[];dataTotal=Number(data.total||0);selectedDataRow=Math.min(selectedDataRow,Math.max(0,dataRows.length-1));document.getElementById("dataLiveChip").textContent="Live database";document.getElementById("dataLiveChip").className="chip good";document.getElementById("dataRedaction").textContent=(data.redacted_fields||[]).length?`Redacted: ${(data.redacted_fields||[]).join(", ")}`:"";renderDataGrid();renderDataTableList();
    }catch(err){if(err?.name==="AbortError")return;document.getElementById("dataError").innerHTML=`<div class="data-error">Could not load rows: ${esc(err?.message||err)}</div>`;dataRows=[];dataTotal=0;renderDataGrid();}
  }

  function renderDataGrid(){
    document.getElementById("dataTableName").textContent=dataTable||"—";const liveTable=liveDb?.tables.find(t=>t.name===dataTable);const columns=dataRows[0]?Object.keys(dataRows[0]):(liveTable?.columns||[]).filter(c=>c.name!=="password_hash").map(c=>c.name);document.getElementById("dataRowSummary").textContent=`${dataTotal} rows`;document.getElementById("dataColumnSummary").textContent=`${columns.length} columns`;document.getElementById("dataHead").innerHTML='<tr><th>#</th>'+columns.map(c=>`<th>${esc(c)}</th>`).join("")+'</tr>';document.getElementById("dataBody").innerHTML=dataRows.map((row,i)=>`<tr data-row="${i}" class="${i===selectedDataRow?"selected":""}"><td>${dataOffset+i+1}</td>${columns.map(c=>`<td>${cellHtml(c,row[c])}</td>`).join("")}</tr>`).join("");document.getElementById("dataEmpty").hidden=dataRows.length>0;document.getElementById("dataGrid").style.display=dataRows.length?"table":"none";document.getElementById("dataShowing").textContent=dataRows.length?`Showing ${dataOffset+1}–${dataOffset+dataRows.length} of ${dataTotal}`:`0 rows`;document.getElementById("dataPage").textContent=String(Math.floor(dataOffset/dataLimit)+1);document.getElementById("dataPrevBtn").disabled=dataOffset===0;document.getElementById("dataNextBtn").disabled=dataOffset+dataRows.length>=dataTotal;document.querySelectorAll("#dataBody tr[data-row]").forEach(tr=>tr.onclick=()=>{selectedDataRow=Number(tr.dataset.row);renderDataGrid();});renderSelectedRow();
  }

  function renderSelectedRow(){const row=dataRows[selectedDataRow];document.getElementById("rowTableChip").textContent=dataTable||"—";if(!row){document.getElementById("rowKey").textContent="No row";document.getElementById("rowFields").innerHTML="";document.getElementById("rowJson").textContent="{}";return;}document.getElementById("rowKey").textContent=String(row.id??`row ${dataOffset+selectedDataRow+1}`);document.getElementById("rowFields").innerHTML=Object.entries(row).map(([k,v])=>`<div class="data-field"><div class="data-field-top"><span class="data-field-name">${esc(k)}</span><span class="data-field-type">${dataType(k,v)}</span></div><div class="data-field-value">${cellHtml(k,v)}</div></div>`).join("");document.getElementById("rowJson").innerHTML=highlightJsonText(JSON.stringify(row,null,2));}

  const defaultIdeas=[];
  let ideas; try{ideas=JSON.parse(localStorage.getItem(IDEA_KEY)||"null")||defaultIdeas;}catch{ideas=[];} let ideaFilter="active";
  function saveIdeas(){try{localStorage.setItem(IDEA_KEY,JSON.stringify(ideas));}catch{}}
  function ideaCounts(){return{active:ideas.filter(x=>x.status==="active").length,done:ideas.filter(x=>x.status==="done").length,trash:ideas.filter(x=>x.status==="trash").length,all:ideas.length};}
  function renderIdeas(){const counts=ideaCounts();document.getElementById("ideaCountActive").textContent=counts.active;document.getElementById("ideaCountDone").textContent=counts.done;document.getElementById("ideaCountTrash").textContent=counts.trash;document.getElementById("ideaCountAll").textContent=counts.all;document.getElementById("ideaOpenChip").textContent=`${counts.active} open`;document.getElementById("ideaDoneChip").textContent=`${counts.done} completed`;document.querySelectorAll("[data-idea-filter]").forEach(btn=>btn.classList.toggle("active",btn.dataset.ideaFilter===ideaFilter));const visible=ideaFilter==="all"?ideas:ideas.filter(x=>x.status===ideaFilter);const list=document.getElementById("ideaList"),empty=document.getElementById("ideaEmpty");if(!visible.length){list.innerHTML="";empty.hidden=false;document.getElementById("ideaEmptyText").textContent=ideaFilter==="active"?"Add an idea above.":"Nothing in this view.";}else{empty.hidden=true;list.innerHTML=visible.map(item=>{const done=item.status==="done",trash=item.status==="trash";const actions=trash?`<button class="idea-action" data-idea-action="restore" data-id="${esc(item.id)}">↶</button><button class="idea-action danger" data-idea-action="delete" data-id="${esc(item.id)}">×</button>`:`<button class="idea-action danger" data-idea-action="trash" data-id="${esc(item.id)}">⌫</button>`;return`<div class="idea-row ${done?"done":""} ${trash?"trash":""}"><button class="idea-check" data-idea-action="toggle" data-id="${esc(item.id)}" ${trash?"disabled":""}>✓</button><div class="idea-text">${esc(item.text)}</div><div class="idea-actions">${actions}</div></div>`;}).join("");}document.getElementById("ideaShowing").textContent=`${visible.length} shown`;document.querySelectorAll("[data-idea-action]").forEach(btn=>btn.onclick=()=>handleIdeaAction(btn.dataset.ideaAction,btn.dataset.id));}
  function addIdea(){const input=document.getElementById("ideaInput"),text=input.value.trim();if(!text)return;ideas.unshift({id:uid(),text,status:"active"});input.value="";ideaFilter="active";saveIdeas();renderIdeas();input.focus();}
  function handleIdeaAction(action,id){const item=ideas.find(x=>x.id===id);if(!item)return;if(action==="toggle"&&item.status!=="trash")item.status=item.status==="done"?"active":"done";if(action==="trash")item.status="trash";if(action==="restore")item.status="active";if(action==="delete")ideas=ideas.filter(x=>x.id!==id);saveIdeas();renderIdeas();}

  async function refreshTopHealth(){const base=String(state.curl.baseUrl||API_DEFAULT).replace(/\/+$/,"").trim();const node=document.getElementById("topHealth");try{const [health,db]=await Promise.all([fetch(base+"/health",{credentials:"include"}),fetch(base+"/db-check",{credentials:"include"})]);if(health.ok&&db.ok){node.innerHTML='<span class="dot"></span> API + PostgreSQL healthy · local';}else throw new Error();}catch{node.innerHTML='<span class="dot" style="background:#b63a33"></span> Local backend unavailable';}}

  const ACTIVE_BUILDER_TAB_KEY="matapon_builder_active_tab_v1";

  if("scrollRestoration" in history){
    history.scrollRestoration="manual";
  }

  function currentBuilderTab(){
    return document.querySelector(".tab.active")?.dataset.target || "schema";
  }

  function compactRailLabel(label){
    const raw=String(label||"").trim();
    const upper=raw.toUpperCase();

    const known={
      "SYSTEM":"SYS",
      "AUTH":"AUTH",
      "USERS + HOUSEHOLDS":"USERS",
      "USERS":"USERS",
      "EVENTS":"EVENTS",
      "ACTIVITIES":"ACT",
      "STAFF":"STAFF",
      "ATTENDANCE":"ATTEND",
      "ADMIN / DEV":"ADMIN",
      "ADMIN":"ADMIN",
      "MANUAL":"MANUAL",
      "OTHER":"OTHER"
    };

    if(known[upper])return known[upper];
    if(upper.length<=7)return upper;

    const words=upper.split(/[^A-Z0-9]+/).filter(Boolean);

    if(words.length>1){
      const acronym=words.map(word=>word[0]).join("");
      if(acronym.length>=2)return acronym.slice(0,7);
    }

    return upper.slice(0,7);
  }

  function closestCard(selector){
    const node=document.querySelector(selector);
    return node?.closest(".card") || node;
  }

  function staticRailSections(tab){
    if(tab==="schema"){
      return [
        {label:"TABLES",target:document.querySelector("#schema .table-nav")},
        {label:"FIELDS",target:document.querySelector("#schema .schema-card")},
        {label:"HEALTH",target:closestCard("#schemaHealthChip")},
        {label:"TRUTHS",target:closestCard("#productTruths")}
      ];
    }

    if(tab==="database"){
      return [
        {label:"MAP",target:closestCard("#dbMap")},
        {label:"DRIFT",target:closestCard("#driftGrid")},
        {label:"TABLE",target:document.querySelector("#database .db-detail")}
      ];
    }

    if(tab==="data"){
      return [
        {label:"TABLES",target:document.querySelector("#data .data-side")},
        {label:"ROWS",target:document.querySelector("#data .data-main")},
        {label:"ROW",target:document.querySelector("#data .data-inspector")}
      ];
    }

    if(tab==="platform"){
      return [
        {label:"STACK",target:closestCard("#repoType")},
        {label:"NAMES",target:document.querySelector("#platform .naming-table")?.closest(".card")},
        {label:"BRIEF",target:closestCard("#buildBrief")},
        {label:"HEALTH",target:closestCard("#platformHealthChip")},
        {label:"RULES",target:document.querySelector("#platform .contract-list")?.closest(".card")},
        {label:"REPO",target:closestCard("#repoShape")}
      ];
    }

    return [];
  }

  function ideaRailSections(){
    return [
      {label:"OPEN",filter:"active"},
      {label:"DONE",filter:"done"},
      {label:"TRASH",filter:"trash"},
      {label:"ALL",filter:"all"}
    ];
  }

  function apiRailSections(){
    return [...document.querySelectorAll(
      "#apiEndpointList [data-api-group-section]"
    )].map(section=>({
      label:compactRailLabel(
        section.querySelector(".api-group-title")?.textContent || ""
      ),
      target:section,
      api:true
    }));
  }

  function currentRailSections(tab=currentBuilderTab()){
    if(tab==="api")return apiRailSections();
    if(tab==="ideas")return ideaRailSections();

    return staticRailSections(tab).filter(section=>section.target);
  }

  function setRailActive(index){
    document.querySelectorAll(
      "#builderSectionRail button"
    ).forEach((button,i)=>{
      button.classList.toggle("active",i===index);
    });
  }

  function jumpToApiSection(target){
    if(!target)return;

    const groupKey=target.dataset.apiGroupSection;
    const firstEndpoint=target.querySelector("[data-api-id]");
    const firstEndpointId=firstEndpoint?.dataset.apiId;

    if(firstEndpointId){
      state.curl.selectedId=firstEndpointId;
      save();
      renderApi();
    }

    requestAnimationFrame(()=>{
      const freshTarget=groupKey
        ? document.querySelector(
            `[data-api-group-section="${CSS.escape(groupKey)}"]`
          )
        : null;

      const body=document.querySelector("#api .api-side .card-body");
      const list=document.getElementById("apiEndpointList");

      if(!body||!list||!freshTarget)return;

      body.scrollTo({
        top:Math.max(
          0,
          freshTarget.offsetTop-list.offsetTop-6
        ),
        behavior:"smooth"
      });
    });
  }

  function jumpToSection(section,index){
    if(section.filter){
      const button=document.querySelector(
        `[data-idea-filter="${CSS.escape(section.filter)}"]`
      );

      if(button)button.click();

      setRailActive(index);
      return;
    }

    if(section.api){
      jumpToApiSection(section.target);
      setRailActive(index);
      return;
    }

    if(!section.target)return;

    section.target.style.scrollMarginTop="92px";

    section.target.scrollIntoView({
      behavior:"smooth",
      block:"start"
    });

    setRailActive(index);
  }

  function renderFloatingSectionRail(tab=currentBuilderTab()){
    const rail=document.getElementById("builderSectionRail");
    if(!rail)return;

    const sections=currentRailSections(tab);

    rail.hidden=!sections.length;

    rail.innerHTML=sections.map((section,index)=>`
      <button
        type="button"
        data-builder-section-index="${index}"
        class="${index===0?"active":""}"
        title="${esc(section.label)}"
      >${esc(section.label)}</button>
    `).join("");

    rail.querySelectorAll(
      "[data-builder-section-index]"
    ).forEach(button=>{
      button.onclick=()=>{
        const index=Number(button.dataset.builderSectionIndex);
        jumpToSection(sections[index],index);
      };
    });

    bindApiSectionScroll();
  }

  function updateWindowRailActive(){
    const tab=currentBuilderTab();

    if(tab==="api"||tab==="ideas")return;

    const sections=currentRailSections(tab);
    if(!sections.length)return;

    let active=0;
    const threshold=120;

    sections.forEach((section,index)=>{
      if(
        section.target &&
        section.target.getBoundingClientRect().top<=threshold
      ){
        active=index;
      }
    });

    setRailActive(active);
  }

  let railScrollQueued=false;

  window.addEventListener("scroll",()=>{
    if(railScrollQueued)return;

    railScrollQueued=true;

    requestAnimationFrame(()=>{
      railScrollQueued=false;
      updateWindowRailActive();
    });
  },{passive:true});

  function bindApiSectionScroll(){
    const body=document.querySelector("#api .api-side .card-body");

    if(!body||body.dataset.floatingRailBound==="true")return;

    body.dataset.floatingRailBound="true";

    body.addEventListener("scroll",()=>{
      if(currentBuilderTab()!=="api")return;

      const sections=currentRailSections("api");
      if(!sections.length)return;

      const bodyTop=body.getBoundingClientRect().top+8;
      let bestIndex=0;
      let bestDistance=Infinity;

      sections.forEach((section,index)=>{
        const distance=Math.abs(
          section.target.getBoundingClientRect().top-bodyTop
        );

        if(distance<bestDistance){
          bestDistance=distance;
          bestIndex=index;
        }
      });

      setRailActive(bestIndex);
    },{passive:true});
  }

  const apiRailObserver=new MutationObserver(()=>{
    if(currentBuilderTab()==="api"){
      renderFloatingSectionRail("api");
    }
  });

  const apiEndpointRoot=document.getElementById("apiEndpointList");

  if(apiEndpointRoot){
    apiRailObserver.observe(apiEndpointRoot,{
      childList:true,
      subtree:true
    });
  }

  function resetTabToRoot(name){
    if(name==="api"){
      const body=document.querySelector("#api .api-side .card-body");
      if(body)body.scrollTop=0;
    }

    window.scrollTo({
      top:0,
      left:0,
      behavior:"auto"
    });

    requestAnimationFrame(()=>{
      renderFloatingSectionRail(name);
      setRailActive(0);
    });
  }

  function openTab(name,{persist=true,resetRoot=true}={}){
    const valid=[...document.querySelectorAll(".tab")]
      .some(tab=>tab.dataset.target===name);

    if(!valid)name="schema";

    document.querySelectorAll(".tab").forEach(tab=>
      tab.classList.toggle(
        "active",
        tab.dataset.target===name
      )
    );

    document.querySelectorAll(".screen").forEach(screen=>
      screen.classList.toggle(
        "active",
        screen.id===name
      )
    );

    if(persist){
      try{
        localStorage.setItem(
          ACTIVE_BUILDER_TAB_KEY,
          name
        );
      }catch{}
    }

    if(name==="schema")renderSchema();
    if(name==="platform")renderPlatform();
    if(name==="api")renderApi();
    if(name==="database")loadDatabaseSchema();

    if(name==="data"){
      loadDatabaseSchema().then(ok=>{
        if(ok){
          if(!dataTable){
            dataTable=liveDb.tables[0]?.name||null;
          }

          renderDataTableList();
          loadDataRows();
        }
      });
    }

    if(name==="ideas")renderIdeas();

    requestAnimationFrame(()=>{
      renderFloatingSectionRail(name);

      if(resetRoot){
        resetTabToRoot(name);
      }
    });
  }

  function restoreBuilderLocation(){
    let saved="schema";

    try{
      const candidate=localStorage.getItem(
        ACTIVE_BUILDER_TAB_KEY
      );

      if(candidate)saved=candidate;
    }catch{}

    openTab(saved,{
      persist:false,
      resetRoot:true
    });
  }

  document.querySelectorAll(".tab").forEach(tab=>{
