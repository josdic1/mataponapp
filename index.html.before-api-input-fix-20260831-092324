    ]},
    { name: "event_types", note: "Admin-editable event taxonomy.", fields: [
      field("id", "PK"), field("name", "TEXT UNIQUE NOT NULL"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "events", note: "Overall event container and event window.", fields: [
      field("id", "PK"), field("name", "TEXT NOT NULL"), field("event_type_id", "FK", "event_types.id"), field("starts_at", "TEXT NOT NULL"), field("ends_at", "TEXT NOT NULL"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "event_type_others", note: "Event-type exception when normal taxonomy does not fit.", fields: [
      field("id", "PK"), field("event_id", "FK", "events.id"), field("value", "TEXT NOT NULL"), field("reason", "TEXT NOT NULL"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "staff_members", note: "Staff profile. Role is staff or manager.", fields: [
      field("id", "PK"), field("user_id", "FK", "users.id"), field("full_name", "TEXT NOT NULL"), field("email", "TEXT"), field("phone", "TEXT"), field("role", "CHOICE", "staff, manager"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "staff_areas", note: "Reusable staff work areas.", fields: [
      field("id", "PK"), field("name", "TEXT UNIQUE NOT NULL"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "staff_member_areas", note: "Areas a staff member works in.", fields: [
      field("id", "PK"), field("staff_member_id", "FK", "staff_members.id"), field("staff_area_id", "FK", "staff_areas.id"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "activities", note: "Reusable activities.", fields: [
      field("id", "PK"), field("name", "TEXT UNIQUE NOT NULL"), field("setting", "CHOICE", "inside, outside, other"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "activity_others", note: "Actual setting when normal activity setting does not fit.", fields: [
      field("id", "PK"), field("activity_id", "FK", "activities.id"), field("value", "TEXT NOT NULL"), field("reason", "TEXT NOT NULL"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "staff_activities", note: "Activities a staff member can do.", fields: [
      field("id", "PK"), field("staff_member_id", "FK", "staff_members.id"), field("activity_id", "FK", "activities.id"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "event_activities", note: "A reusable activity scheduled into a specific event.", fields: [
      field("id", "PK"), field("event_id", "FK", "events.id"), field("activity_id", "FK", "activities.id"), field("starts_at", "TEXT NOT NULL"), field("ends_at", "TEXT NOT NULL"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "event_activity_staff", note: "Staff booked to work a scheduled activity.", fields: [
      field("id", "PK"), field("event_activity_id", "FK", "event_activities.id"), field("staff_member_id", "FK", "staff_members.id"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "member_attendees", note: "Household members registered for an overall event.", fields: [
      field("id", "PK"), field("member_id", "FK", "user_members.id"), field("event_id", "FK", "events.id"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "event_activity_signups", note: "Signup sheet for a scheduled activity; checked_in_at records actual participation.", fields: [
      field("id", "PK"), field("event_activity_id", "FK", "event_activities.id"), field("member_attendee_id", "FK", "member_attendees.id"), field("checked_in_at", "TEXT", "null until staff/admin confirms participation"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "audit_log", note: "Append-only history of row changes across product tables.", fields: [
      field("id", "PK"), field("table_name", "TEXT NOT NULL"), field("row_id", "TEXT NOT NULL"), field("action", "CHOICE", "INSERT, UPDATE, DELETE"), field("old_values", "JSONB"), field("new_values", "JSONB"), field("actor_user_id", "BIGINT"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
  ];

  const defaultState = {
    projectName: "mataponapp",
    productTruths: "Household accounts are shared logins; user_members are the actual people. Exactly one primary member is required per household once members exist. Events contain scheduled activities. Household members can see event activities and participant lists and can sign up their own household members. Staff/admin confirm actual activity participation with checked_in_at. Duplicate and overlapping activity signups are blocked; back-to-back activities are allowed. Audit history is append-only.",
    platform: {
      repoType: "monorepo",
      frontendFolder: "frontend",
      backendFolder: "backend",
      frontendStack: "React + React Router",
      frontendDeploy: "Netlify",
      cssStrategy: "Reusable token-based CSS",
      backendRuntime: "Node.js",
      backendServer: "Express",
      backendLanguage: "TypeScript",
      validation: "Zod",
      databaseAccess: "PostgreSQL · Pure SQL",
      backendDeploy: "Railway",
    },
    curl: {
      baseUrl: API_DEFAULT,
      endpoints: [],
      values: {},
      lastSync: null,
      syncError: "",
      selectedId: null,
      groups: [],
      groupOverrides: {},
      groupEditorOpen: false
    },
    tables: defaultTables,
  };

  function clone(value) { return JSON.parse(JSON.stringify(value)); }
  function loadState() {
    try {
      const current = JSON.parse(localStorage.getItem(KEY) || "null");
      if (current) return current;
      const old = JSON.parse(localStorage.getItem(OLD_KEY) || "null");
      return old || null;
    } catch { return null; }
  }

  let state = loadState() || clone(defaultState);
  state.projectName ||= defaultState.projectName;
  const OLD_PRODUCT_TRUTHS = "Users can be member, staff, or admin. Member accounts can contain multiple household people. Events have start/end windows. Activities are reusable and can be scheduled into events. Staff are staff or manager. Staff have activities they CAN do and can be booked to specific event activities. Event activity signups also store check-in. Activity setting is inside, outside, or other; OTHER stores the actual setting and reason.";
  if (!state.productTruths || state.productTruths === OLD_PRODUCT_TRUTHS) state.productTruths = defaultState.productTruths;
  state.platform = { ...defaultState.platform, ...(state.platform || {}) };
  state.curl = { ...defaultState.curl, ...(state.curl || {}) };
  state.curl.values ||= {};
  state.curl.groupOverrides ||= {};
  state.curl.groupEditorOpen = !!state.curl.groupEditorOpen;
  state.curl.endpoints = Array.isArray(state.curl.endpoints) ? state.curl.endpoints : [];
  state.tables = Array.isArray(state.tables) && state.tables.length ? state.tables : clone(defaultTables);
  if (!state.tables.some((t) => t.name === "audit_log")) state.tables.push(clone(defaultTables.find((t) => t.name === "audit_log")));

  let selectedSchemaIndex = 0;
  let liveDb = null;
  let selectedDbTable = null;
  let dataTable = null;
  let dataRows = [];
  let dataTotal = 0;
  let dataOffset = 0;
  const dataLimit = 100;
  let selectedDataRow = 0;
  let dataAbort = null;

  function save() { localStorage.setItem(KEY, JSON.stringify(state)); }
  function esc(v) { return String(v ?? "").replace(/[&<>"']/g, (m) => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"})[m]); }

  function jsonValueHtml(raw,key="") {
    const value=String(raw??"");
    const trimmed=value.trim();

    if(/^"(?:\\.|[^"\\])*"$/.test(trimmed)){
      const cls=
        (key==="id"||key.endsWith("_id"))
          ?"json-id-value"
          :((key.endsWith("_at")||key==="starts_at"||key==="ends_at")
            ?"json-time-value"
            :"json-string");

      return `<span class="${cls}">${esc(value)}</span>`;
    }

    if(/^-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?$/.test(trimmed))
      return `<span class="json-number">${esc(value)}</span>`;

    if(trimmed==="true"||trimmed==="false")
      return `<span class="json-boolean">${esc(value)}</span>`;

    if(trimmed==="null")
      return `<span class="json-null">${esc(value)}</span>`;

    return esc(value);
  }

  function highlightJsonText(text) {
    let pretty=String(text??"");

    try {
      pretty=JSON.stringify(JSON.parse(pretty),null,2);
    } catch {
      return `<span class="json-plain">${esc(pretty)}</span>`;
    }

    return pretty.split("\n").map(line=>{
      const match=line.match(/^(\s*)"([^"\\]*(?:\\.[^"\\]*)*)"(\s*:\s*)(.*?)(,?)$/);

      if(!match) return esc(line);

      const [,indent,keyRaw,separator,value,comma]=match;

      let key=keyRaw;
      try {
        key=JSON.parse(`"${keyRaw}"`);
      } catch {}

      const keyClass=
        indent.length===2
          ?"json-key json-key-root"
          :(key==="id"
            ?"json-key json-key-id"
            :(key.endsWith("_id")
              ?"json-key json-key-fk"
              :"json-key"));

      return `${esc(indent)}<span class="${keyClass}">"${esc(keyRaw)}"</span>${esc(separator)}${jsonValueHtml(value,key)}${esc(comma)}`;
    }).join("\n");
  }
  function toast(message) {
    const node = document.getElementById("toast");
    node.textContent = message;
    node.classList.add("show");
    clearTimeout(toast.timer);
    toast.timer = setTimeout(() => node.classList.remove("show"), 1200);
  }
  function snake(s) { return String(s || "").trim().replace(/([a-z0-9])([A-Z])/g,"$1_$2").replace(/[^a-zA-Z0-9]+/g,"_").replace(/^_+|_+$/g,"").toLowerCase().replace(/_+/g,"_"); }
  function pluralize(w) {
    const ir={activity:"activities",category:"categories",person:"people",child:"children",staff:"staff"};
    if(ir[w]) return ir[w]; if(w.endsWith("s")) return w; if(/[^aeiou]y$/.test(w)) return w.slice(0,-1)+"ies"; if(/(x|z|ch|sh)$/.test(w)) return w+"es"; return w+"s";
  }
  function tableSuggestion(n) { let s=snake(n); if(!s) return ""; const p=s.split("_"); p[p.length-1]=pluralize(p[p.length-1]); return p.join("_"); }

  function schemaIssues() {
    const issues=[]; const tableNames=new Map();
    state.tables.forEach((t,ti)=>{
      if(!t.name) issues.push({level:"error",text:"Table has no name.",ti});
      const suggestion=tableSuggestion(t.name);
      if(t.name && suggestion!==t.name) issues.push({level:"warning",text:`${t.name}: naming suggests ${suggestion}.`,ti});
      if(tableNames.has(t.name)) issues.push({level:"error",text:`Duplicate table ${t.name}.`,ti});
      tableNames.set(t.name,ti);
      const fields=new Set();
      (t.fields||[]).forEach((f,fi)=>{
        if(!f.name) issues.push({level:"error",text:`${t.name}: unnamed field.`,ti,fi});
        if(fields.has(f.name)) issues.push({level:"error",text:`${t.name}: duplicate field ${f.name}.`,ti,fi});
        fields.add(f.name);
        if(f.name && snake(f.name)!==f.name) issues.push({level:"warning",text:`${t.name}.${f.name}: use snake_case.`,ti,fi});
        if(f.definition==="FK") {
          const [tt,ff]=String(f.details||"").split(".");
          const target=state.tables.find(x=>x.name===tt);
          if(!target || !ff || !(target.fields||[]).some(x=>x.name===ff)) issues.push({level:"error",text:`${t.name}.${f.name}: broken FK target ${f.details||"(missing)"}.`,ti,fi});
