<script>
(() => {
  "use strict";

  const KEY = "matapon_builder_v2";
  const OLD_KEY = "matapon_builder_v1";
  const IDEA_KEY = "matapon_builder_idea_log_v1";
  const API_DEFAULT = "http://localhost:3001";

  const uid = () => Math.random().toString(36).slice(2) + Date.now().toString(36);
  const field = (name, definition, details = "", tags = "") => ({
    id: uid(), name, definition, details, tags,
  });

  const defaultTables = [
    { name: "users", note: "Shared household/staff/admin login account.", fields: [
      field("id", "PK"), field("username", "TEXT UNIQUE NOT NULL"), field("password_hash", "TEXT NOT NULL"), field("must_change_password", "BOOLEAN NOT NULL DEFAULT TRUE"), field("user_type", "CHOICE", "member, staff, admin"), field("created_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"), field("updated_at", "TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")
    ]},
    { name: "user_members", note: "Actual people inside a member household account.", fields: [
