  function currentDriftCount() {
    if(!liveDb) return null;
    const liveNames=new Set(liveDb.tables.map(t=>t.name));
    const builderNames=new Set(state.tables.map(t=>t.name));
    let drift=0;
    for(const name of new Set([...liveNames,...builderNames])) {
      if(!liveNames.has(name)||!builderNames.has(name)){drift++;continue;}
      const live=liveDb.tables.find(t=>t.name===name);
      const intended=state.tables.find(t=>t.name===name);
      const lc=new Set(live.columns.map(c=>c.name));
      const bc=new Set((intended.fields||[]).map(f=>f.name));
      if(lc.size!==bc.size || [...lc].some(c=>!bc.has(c))) drift++;
    }
    return drift;
  }

