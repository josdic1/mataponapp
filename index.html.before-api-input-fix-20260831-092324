<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Matapon Builder</title>
<style>
  :root{
    --bg:#f6f5f1;
    --surface:#ffffff;
    --surface-2:#fbfaf7;
    --ink:#171915;
    --muted:#6d7169;
    --line:#dddcd5;
    --line-strong:#c8c7bf;
    --accent:#007854;
    --accent-soft:#e7f3ef;
    --accent-ink:#005d41;
    --warning:#a86600;
    --warning-soft:#fff4dc;
    --danger:#b63a33;
    --danger-soft:#fff0ef;
    --code:#171a17;
    --radius:12px;
  }
  *{box-sizing:border-box}
  html,body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:14px}
  button,input,textarea{font:inherit;color:inherit}
  button{cursor:pointer}
  code,.mono{font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace}

  .app{min-height:100vh}
  .topbar{
    height:64px;position:sticky;top:0;z-index:30;display:flex;align-items:center;
    gap:18px;padding:0 24px;background:rgba(255,255,255,.94);backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line)
  }
  .brand{display:flex;align-items:center;gap:10px;min-width:max-content}
  .mark{width:28px;height:28px;border-radius:8px;background:var(--accent);display:grid;place-items:center;color:#fff;font-weight:800;font-size:12px;letter-spacing:-.02em}
  .brand-copy{line-height:1.02}
  .brand-name{font-weight:760;letter-spacing:-.03em;font-size:15px}
  .brand-sub{margin-top:3px;color:var(--muted);font-size:11px}
  .project-switch{display:flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:var(--surface-2);font-weight:650;min-width:145px}
  .chev{color:var(--muted);font-size:11px;margin-left:auto}
  .tabs{display:flex;align-self:stretch;gap:22px;margin-left:4px}
  .tab{position:relative;border:0;background:transparent;padding:0 1px;color:var(--muted);font-weight:650}
  .tab:hover{color:var(--ink)}
  .tab.active{color:var(--ink)}
  .tab.active:after{content:"";position:absolute;height:2px;left:0;right:0;bottom:0;background:var(--accent);border-radius:2px 2px 0 0}
  .top-spacer{flex:1}
  .status-pill{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px;white-space:nowrap}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--accent)}
  .btn{height:34px;border:1px solid var(--line);border-radius:8px;background:var(--surface);padding:0 12px;font-weight:650;display:inline-flex;align-items:center;gap:7px}
  .btn:hover{border-color:var(--line-strong);background:var(--surface-2)}
  .btn.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  .btn.primary:hover{background:#006a4a}
  .btn.ghost{background:transparent}
  .btn.icon{width:34px;padding:0;justify-content:center}

  main{max-width:1500px;margin:0 auto;padding:28px 32px 56px}
  .screen{display:none}.screen.active{display:block}
  .page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}
  .eyebrow{font-size:11px;font-weight:750;color:var(--accent);letter-spacing:.08em;text-transform:uppercase;margin-bottom:7px}
  h1{margin:0;font-size:28px;line-height:1.05;letter-spacing:-.04em;font-weight:740}
  .subtitle{margin-top:8px;color:var(--muted);max-width:720px;line-height:1.45}
  .summary{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
  .chip{height:28px;padding:0 9px;border:1px solid var(--line);border-radius:999px;background:var(--surface);display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;color:var(--muted)}
  .chip.good{background:var(--accent-soft);color:var(--accent-ink);border-color:#b7ddcf}
  .chip.warn{background:var(--warning-soft);color:var(--warning);border-color:#ecd29d}

  .grid{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(320px,.8fr);gap:18px;align-items:start}
  .stack{display:flex;flex-direction:column;gap:18px}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
  .card-head{padding:16px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:14px}
  .card-title{font-weight:730;letter-spacing:-.015em}
  .card-kicker{font-size:11px;color:var(--muted);margin-top:3px}
  .card-body{padding:18px}
  .mini-action{border:0;background:transparent;color:var(--accent);font-size:12px;font-weight:700;padding:4px 0}

  .config-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;border:1px solid var(--line);border-radius:10px;overflow:hidden}
  .config-group{background:var(--surface)}
  .config-group+.config-group{border-left:1px solid var(--line)}
  .config-label{padding:11px 13px;background:var(--surface-2);border-bottom:1px solid var(--line);font-size:11px;font-weight:760;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
  .field{padding:11px 13px;border-bottom:1px solid var(--line)}
  .field:last-child{border-bottom:0}
  .field-name{font-size:10px;letter-spacing:.055em;text-transform:uppercase;color:var(--muted);font-weight:740;margin-bottom:5px}
  .field-value{display:flex;align-items:center;gap:8px;font-weight:650;min-height:24px}
  .field-value input{width:100%;border:0;background:transparent;outline:none;padding:0;font-weight:650}
  .field-value .edit{margin-left:auto;color:#9a9d96;font-size:12px;opacity:.75}
  .hint{font-size:10px;color:#999b95;margin-top:4px}

  .contract-list{display:flex;flex-direction:column}
  .contract-item{display:grid;grid-template-columns:20px 1fr auto;gap:9px;align-items:start;padding:10px 0;border-bottom:1px solid var(--line)}
  .contract-item:last-child{border-bottom:0}
  .check{width:18px;height:18px;border-radius:50%;background:var(--accent-soft);color:var(--accent);display:grid;place-items:center;font-weight:800;font-size:11px;margin-top:1px}
  .contract-main{font-weight:640;line-height:1.35}
  .contract-sub{font-size:11px;color:var(--muted);margin-top:3px;line-height:1.4}
  .lock{font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:3px 6px;background:var(--surface-2)}

  .repo-tree{background:var(--code);color:#e8ece8;border-radius:10px;padding:15px 16px;font-size:12px;line-height:1.7;overflow:auto}
  .repo-tree .muted{color:#8f988f}.repo-tree .accent{color:#7fd1b5}

  .naming-table{display:grid;grid-template-columns:1.05fr 1fr .8fr}
  .naming-table>div{padding:11px 13px;border-bottom:1px solid var(--line)}
  .naming-table>div:nth-last-child(-n+3){border-bottom:0}
  .naming-table .head{background:var(--surface-2);font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:760}
  .rule{font-weight:630}.example{font-size:12px;color:#4f544c}.scope{font-size:11px;color:var(--muted)}

  .brief{background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:15px 16px;min-height:155px;line-height:1.65;font-size:12px;color:#3d423b;white-space:pre-wrap}

  .health-card{position:sticky;top:82px}
  .health-top{display:grid;grid-template-columns:1fr auto;gap:12px;padding-bottom:14px;margin-bottom:14px;border-bottom:1px solid var(--line)}
  .big-number{font-size:26px;letter-spacing:-.04em;font-weight:760}.big-number small{font-size:11px;color:var(--muted);font-weight:650;letter-spacing:0}
  .meter{height:6px;background:#ecece7;border-radius:99px;overflow:hidden;margin-top:8px}.meter>span{display:block;width:100%;height:100%;background:var(--accent)}
  .metric-list{display:grid;grid-template-columns:1fr auto;gap:9px 12px;font-size:12px}
  .metric-list .label{color:var(--muted)}.metric-list .value{font-weight:720}
  .callout{margin-top:14px;padding:11px 12px;border-radius:9px;background:var(--accent-soft);color:var(--accent-ink);font-size:11px;line-height:1.45}

  /* Schema mockup */
  .schema-layout{display:grid;grid-template-columns:220px minmax(0,1fr) 310px;gap:18px;align-items:start}
  .table-nav{position:sticky;top:82px}
  .search{width:100%;height:35px;border:1px solid var(--line);border-radius:8px;padding:0 10px;background:var(--surface-2);outline:none}
  .nav-list{display:flex;flex-direction:column;margin-top:10px;gap:3px;max-height:70vh;overflow:auto}
  .nav-item{padding:9px 10px;border-radius:7px;color:var(--muted);font-size:12px;display:flex;align-items:center;justify-content:space-between;gap:8px}
  .nav-item.active{background:var(--accent-soft);color:var(--accent-ink);font-weight:700}.nav-item:hover{background:var(--surface-2)}
  .count{font-size:10px;opacity:.7}
  .schema-card .card-head{padding:15px 16px}
  .schema-title{font-size:20px;font-weight:750;letter-spacing:-.03em}
  .schema-note{font-size:12px;color:var(--muted);margin-top:4px}
  .schema-table{display:grid;grid-template-columns:1.05fr 1fr 1.35fr 42px}
  .schema-table>div{padding:10px 12px;border-bottom:1px solid var(--line);min-width:0}
  .schema-table .head{background:var(--surface-2);font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:760}
  .schema-table .fieldname{font-family:"SFMono-Regular",Consolas,monospace;font-weight:700;font-size:12px}
  .type-pill{display:inline-flex;padding:3px 6px;border-radius:5px;background:#f1f1ed;font-family:"SFMono-Regular",Consolas,monospace;font-size:10px}
  .schema-table .last-row{border-bottom:0}
  .truth{padding:10px 0;border-bottom:1px solid var(--line);font-size:12px;line-height:1.45}.truth:last-child{border-bottom:0}
  .truth .num{font-size:10px;color:var(--muted);font-weight:700;margin-bottom:3px}

  /* Live database mockup */
  .db-layout{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:18px;align-items:start}
  .db-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .db-source{height:34px;border:1px solid var(--line);border-radius:8px;background:var(--surface-2);padding:0 10px;font-size:12px;color:var(--muted);display:flex;align-items:center;gap:7px}
  .pulse{width:7px;height:7px;border-radius:50%;background:var(--accent);box-shadow:0 0 0 4px var(--accent-soft)}
  .db-map-wrap{overflow:auto;background:#f8f8f5}
  .db-map{position:relative;width:1100px;height:610px;min-width:1100px;background-image:radial-gradient(#d7d8d2 .7px,transparent .7px);background-size:18px 18px}
  .db-map svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;overflow:visible}
  .db-edge{fill:none;stroke:#c6c9c2;stroke-width:1.25;opacity:.85}
  .db-edge.active{stroke:var(--accent);stroke-width:1.8;opacity:1}
  .db-node{position:absolute;width:190px;min-height:72px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.97);padding:11px 12px;box-shadow:0 1px 0 rgba(20,30,20,.025);transition:.14s ease;cursor:pointer}
  .db-node:hover{border-color:#b9c0b9;transform:translateY(-1px)}
  .db-node.active{border-color:#8ccab5;box-shadow:0 0 0 3px var(--accent-soft);background:#fff}
  .db-node-name{font-family:"SFMono-Regular",Consolas,monospace;font-size:12px;font-weight:760;letter-spacing:-.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .db-node-meta{display:flex;align-items:center;gap:7px;margin-top:8px;color:var(--muted);font-size:10px}
  .db-node-meta b{color:var(--ink);font-weight:740}
  .db-node-tag{margin-left:auto;padding:2px 5px;border-radius:4px;background:#f0f1ed;font-size:9px;font-weight:720;text-transform:uppercase;letter-spacing:.04em}
  .db-domain{position:absolute;font-size:9px;text-transform:uppercase;letter-spacing:.1em;font-weight:800;color:#a0a49d;pointer-events:none}
  .db-detail{position:sticky;top:82px}
  .db-table-name{
  display:inline-flex;
  align-items:center;
  margin-top:5px;
  padding:5px 9px 6px;
  border:1px solid #d6e2dc;
  border-radius:7px;
  background:#f3f7f5;
  color:var(--accent-ink);
  font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace;
  font-size:15px;
  line-height:1;
  font-weight:760;
  letter-spacing:-.025em;
}
  .db-stat-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:9px;overflow:hidden;margin-bottom:15px}
  .db-stat{padding:10px;background:var(--surface-2);text-align:center}
  .db-stat+.db-stat{border-left:1px solid var(--line)}
  .db-stat strong{display:block;font-size:16px;letter-spacing:-.03em}.db-stat span{display:block;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.05em;margin-top:2px;font-weight:720}
  .db-detail-section{padding:12px 0;border-top:1px solid var(--line)}
  .db-detail-section:first-of-type{border-top:0;padding-top:0}
  .db-detail-label{font-size:9px;text-transform:uppercase;letter-spacing:.075em;color:var(--muted);font-weight:780;margin-bottom:7px}
  .db-column{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;padding:5px 0;font-size:11px;align-items:center}
  .db-column code{font-weight:700}.db-column span{font-family:"SFMono-Regular",Consolas,monospace;color:var(--muted);font-size:10px;text-align:right}
  .db-relation{font-size:11px;line-height:1.45;padding:4px 0;color:#4d524b}.db-relation code{font-size:10px;font-weight:700}
  .drift-grid{display:grid;grid-template-columns:1.2fr repeat(3,.7fr);align-items:center}
  .drift-grid>div{padding:10px 12px;border-bottom:1px solid var(--line);font-size:11px}
  .drift-grid>div:nth-last-child(-n+4){border-bottom:0}
  .drift-grid .head{background:var(--surface-2);font-size:9px;text-transform:uppercase;letter-spacing:.065em;color:var(--muted);font-weight:780}
  .same{color:var(--accent-ink);font-weight:760}
  .snapshot-bar{padding:10px 14px;border-top:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--surface-2);font-size:10px;color:var(--muted)}
  .snapshot-bar strong{color:var(--ink)}

  /* Live data browser */
  .data-layout{display:grid;grid-template-columns:220px minmax(0,1fr) 350px;gap:18px;align-items:start}
  .data-side{position:sticky;top:82px}
  .data-table-list{display:flex;flex-direction:column;gap:3px;max-height:calc(100vh - 235px);overflow:auto;padding-right:2px}
  .data-table-item{border:0;background:transparent;width:100%;padding:9px 10px;border-radius:7px;display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--muted);text-align:left}
  .data-table-item:hover{background:var(--surface-2);color:var(--ink)}
  .data-table-item.active{background:var(--accent-soft);color:var(--accent-ink);font-weight:730}
  .data-table-item code{font-size:11px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .data-table-count{font-size:9px;min-width:26px;text-align:right;opacity:.72}
  .data-main{min-width:0}
  .data-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .data-toolbar .search{width:min(360px,42vw)}
  .data-table-shell{overflow:auto;max-height:62vh;background:var(--surface)}
  .data-grid{width:100%;border-collapse:separate;border-spacing:0;font-size:11px;white-space:nowrap}
  .data-grid th{position:sticky;top:0;z-index:3;background:var(--surface-2);border-bottom:1px solid var(--line-strong);padding:9px 11px;text-align:left;font-size:9px;text-transform:uppercase;letter-spacing:.065em;color:var(--muted);font-weight:800}
  .data-grid th:first-child{left:0;z-index:5;min-width:38px;text-align:right}
  .data-grid td{border-bottom:1px solid var(--line);padding:9px 11px;max-width:260px;overflow:hidden;text-overflow:ellipsis;vertical-align:middle}
  .data-grid td:first-child{position:sticky;left:0;z-index:2;background:#fff;color:#a0a39e;text-align:right;font-size:9px;min-width:38px;border-right:1px solid var(--line)}
  .data-grid tr:last-child td{border-bottom:0}
  .data-grid tbody tr{cursor:pointer}
  .data-grid tbody tr:hover td{background:#fafbf9}
  .data-grid tbody tr:hover td:first-child{background:#fafbf9}
  .data-grid tbody tr.selected td{background:var(--accent-soft)}
  .data-grid tbody tr.selected td:first-child{background:#dff0e9;color:var(--accent-ink);font-weight:800}
  .data-cell-id{font-family:"SFMono-Regular",Consolas,monospace;font-size:10px;color:#40443f}
  .data-cell-muted{color:var(--muted)}
  .null-pill{display:inline-flex;padding:2px 5px;border-radius:4px;background:#f0f1ed;color:#92958f;font-size:9px;font-style:italic}
  .bool-pill{display:inline-flex;align-items:center;gap:4px;padding:2px 6px;border-radius:999px;background:#f0f1ed;font-size:9px;font-weight:750}
  .bool-pill.true{background:var(--accent-soft);color:var(--accent-ink)}
  .fk-pill{display:inline-flex;align-items:center;gap:5px;max-width:190px;padding:3px 6px;border-radius:5px;background:#f2f4f1;border:1px solid #e3e5e0;font-family:"SFMono-Regular",Consolas,monospace;font-size:9px;color:#4f554f}
  .fk-pill::before{content:'↗';color:var(--accent);font-family:inherit;font-weight:800}
  .data-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px;border-top:1px solid var(--line);background:var(--surface-2);font-size:10px;color:var(--muted)}
  .pager{display:flex;align-items:center;gap:5px}.pager button{height:27px;min-width:27px;border:1px solid var(--line);border-radius:6px;background:#fff;color:var(--muted)}.pager button:disabled{opacity:.4;cursor:default}
  .data-inspector{position:sticky;top:82px;max-height:calc(100vh - 105px);overflow:hidden;display:flex;flex-direction:column}
  .data-inspector .card-body{overflow:auto}
  .row-key{font-family:"SFMono-Regular",Consolas,monospace;font-size:15px;font-weight:760;letter-spacing:-.025em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:260px}
  .row-meta{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:7px}
  .data-field{padding:9px 0;border-bottom:1px solid var(--line)}
  .data-field:last-child{border-bottom:0}
  .data-field-top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:4px}
  .data-field-name{font-family:"SFMono-Regular",Consolas,monospace;font-size:10px;font-weight:760}
  .data-field-type{font-size:8px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:750}
  .data-field-value{font-size:11px;line-height:1.45;overflow-wrap:anywhere;word-break:break-word}
  .raw-json{background:var(--code);color:#dfe5df;border-radius:9px;padding:14px 16px;font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace;font-size:11.5px;line-height:1.68;white-space:pre;overflow:auto;max-height:360px;tab-size:2}
  .data-empty{padding:46px 24px;text-align:center;color:var(--muted)}
  .data-empty strong{display:block;color:var(--ink);font-size:13px;margin-bottom:5px}


  /* Idea Log */
  .ideas-wrap{max-width:920px;margin:0 auto}
  .idea-compose{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;padding:14px;border-bottom:1px solid var(--line);background:var(--surface-2)}
  .idea-input{height:42px;border:1px solid var(--line);border-radius:9px;background:#fff;padding:0 13px;outline:none;font-size:13px}
  .idea-input:focus{border-color:#9bcdbd;box-shadow:0 0 0 3px var(--accent-soft)}
  .idea-filterbar{display:flex;align-items:center;gap:4px;padding:10px 14px;border-bottom:1px solid var(--line);overflow:auto;background:#fff}
  .idea-filter{height:29px;border:0;border-radius:7px;background:transparent;padding:0 9px;color:var(--muted);font-size:11px;font-weight:700;white-space:nowrap}
  .idea-filter:hover{background:var(--surface-2);color:var(--ink)}
  .idea-filter.active{background:var(--accent-soft);color:var(--accent-ink)}
  .idea-filter-count{opacity:.65;margin-left:4px;font-variant-numeric:tabular-nums}
  .idea-list{display:flex;flex-direction:column}
  .idea-row{display:grid;grid-template-columns:30px minmax(0,1fr) auto;gap:9px;align-items:center;min-height:52px;padding:7px 12px;border-bottom:1px solid var(--line);background:#fff}
  .idea-row:last-child{border-bottom:0}
  .idea-row:hover{background:#fcfcfa}
  .idea-check{width:22px;height:22px;border:1px solid var(--line-strong);border-radius:50%;background:#fff;display:grid;place-items:center;padding:0;color:transparent;font-size:12px;font-weight:900;transition:.12s ease}
  .idea-check:hover{border-color:#8bbfab;background:var(--accent-soft)}
  .idea-row.done .idea-check{background:var(--accent);border-color:var(--accent);color:#fff}
  .idea-text{font-size:13px;line-height:1.4;min-width:0;overflow-wrap:anywhere}
