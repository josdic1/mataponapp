    const merged=[];

    API_GROUP_DEFAULTS.forEach(def=>{
      const existing=byKey.get(def.key);
      merged.push({
        key:def.key,
        label:String(existing?.label||def.label),
        short:String(existing?.short||def.short),
        custom:false,
      });
      byKey.delete(def.key);
