  document.getElementById("exportBtn").onclick=()=>{save();const blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=`${state.projectName}-builder.json`;a.click();URL.revokeObjectURL(a.href);};
  document.getElementById("importBtn").onclick=()=>document.getElementById("importFile").click();
  document.getElementById("importFile").onchange=async e=>{const file=e.target.files?.[0];if(!file)return;try{const next=JSON.parse(await file.text());if(!next||!Array.isArray(next.tables))throw new Error("Missing tables");state={...clone(defaultState),...next,platform:{...defaultState.platform,...(next.platform||{})},curl:{...defaultState.curl,...(next.curl||{})}};state.curl.values||={};state.curl.endpoints=Array.isArray(state.curl.endpoints)?state.curl.endpoints.map(normalizeEndpoint):[];if(!state.tables.some(t=>t.name==="audit_log"))state.tables.push(clone(defaultTables.find(t=>t.name==="audit_log")));save();selectedSchemaIndex=0;document.getElementById("projectBadge").textContent=state.projectName;renderSchema();renderPlatform();renderApi();toast("Builder state imported");}catch{toast("Could not import that Builder JSON");}finally{e.target.value="";}};

  document.getElementById("curlBaseUrl").addEventListener("input",e=>{state.curl.baseUrl=e.target.value.trim()||API_DEFAULT;save();renderApiWorkspace();refreshTopHealth();});
  document.getElementById("apiSearch").addEventListener("input",renderApiList);

  document.getElementById("editApiGroupsBtn").onclick=()=>{
    state.curl.groupEditorOpen=!state.curl.groupEditorOpen;
    save();
    renderApiList();
  };
  document.getElementById("syncEndpointsBtn").onclick=()=>syncDynamicEndpoints(false);
  document.getElementById("addEndpointBtn").onclick=()=>{const name=prompt("Endpoint name?","New Endpoint");if(name===null)return;const method=(prompt("Method? GET, POST, PATCH, PUT, DELETE","GET")||"GET").toUpperCase();const path=prompt("Path?","/api/")||"/api/";const ep=normalizeEndpoint({id:uid(),name:name.trim()||"New Endpoint",method,path,source:"manual",auth:false,setsSession:false,inputs:[]});state.curl.endpoints.push(ep);state.curl.selectedId=ep.id;save();renderApi();};

  document.getElementById("refreshDbBtn").onclick=()=>loadDatabaseSchema(true);
  document.getElementById("fitDbBtn").onclick=()=>{const wrap=document.querySelector(".db-map-wrap");if(wrap){wrap.scrollLeft=0;wrap.scrollTop=0;}drawDbEdges();};
  window.addEventListener("resize",drawDbEdges);

  let searchTimer=null;
  document.getElementById("dataTableSearch").addEventListener("input",renderDataTableList);
  document.getElementById("rowSearch").addEventListener("input",()=>{clearTimeout(searchTimer);searchTimer=setTimeout(()=>{dataOffset=0;selectedDataRow=0;loadDataRows();},250);});
  document.getElementById("clearRowSearch").onclick=()=>{document.getElementById("rowSearch").value="";dataOffset=0;loadDataRows();};
  document.getElementById("refreshDataBtn").onclick=()=>loadDatabaseSchema(true).then(ok=>{if(ok){renderDataTableList();loadDataRows();}});
  document.getElementById("dataPrevBtn").onclick=()=>{dataOffset=Math.max(0,dataOffset-dataLimit);selectedDataRow=0;loadDataRows();};
  document.getElementById("dataNextBtn").onclick=()=>{if(dataOffset+dataRows.length>=dataTotal)return;dataOffset+=dataLimit;selectedDataRow=0;loadDataRows();};
  document.getElementById("copyRowBtn").onclick=async()=>{const row=dataRows[selectedDataRow];if(!row)return;await navigator.clipboard.writeText(JSON.stringify(row,null,2));toast("Row JSON copied");};

  document.getElementById("addIdeaBtn").onclick=addIdea;
  document.getElementById("ideaInput").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();addIdea();}});
  document.querySelectorAll("[data-idea-filter]").forEach(btn=>btn.onclick=()=>{ideaFilter=btn.dataset.ideaFilter;renderIdeas();});

  document.getElementById("projectBadge").textContent=state.projectName;
  renderSchema();renderPlatform();renderApi();renderIdeas();refreshTopHealth();
  syncDynamicEndpoints(true);
  restoreBuilderLocation();
  save();
})();

</script>
