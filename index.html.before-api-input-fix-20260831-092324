  document.getElementById("selectedTableNote").addEventListener("input",e=>{const t=state.tables[selectedSchemaIndex];if(!t)return;t.note=e.target.value;save();});
  document.getElementById("productTruths").addEventListener("input",e=>{state.productTruths=e.target.value;save();renderPlatformSummary();});
  document.getElementById("addFieldBtn").onclick=()=>{const t=state.tables[selectedSchemaIndex];if(!t)return;t.fields.push(field("new_field","TEXT"));save();renderSchema();};
  document.getElementById("addTableBtn").onclick=()=>{state.tables.push({name:"new_tables",note:"",fields:[field("id","PK"),field("created_at","TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP"),field("updated_at","TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP")]});selectedSchemaIndex=state.tables.length-1;save();renderSchema();};
  document.getElementById("deleteTableBtn").onclick=()=>{const t=state.tables[selectedSchemaIndex];if(!t||!confirm(`Delete ${t.name} from the Builder schema? This does not alter PostgreSQL.`))return;state.tables.splice(selectedSchemaIndex,1);selectedSchemaIndex=Math.max(0,selectedSchemaIndex-1);save();renderSchema();};
  document.getElementById("tableUpBtn").onclick=()=>{if(selectedSchemaIndex<=0)return;[state.tables[selectedSchemaIndex-1],state.tables[selectedSchemaIndex]]=[state.tables[selectedSchemaIndex],state.tables[selectedSchemaIndex-1]];selectedSchemaIndex--;save();renderSchema();};
